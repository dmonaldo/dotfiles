#!/bin/bash
# Block yadm commits that stage a secret. The dotfiles repo is public.
# Bypass a false positive with: GITLEAKS_SKIP=1 yadm commit ...

[ -n "$GITLEAKS_SKIP" ] && exit 0
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "yadm: gitleaks not installed (brew install gitleaks); refusing to commit unscanned" >&2
  exit 1
fi

export GIT_DIR="$YADM_HOOK_REPO" GIT_WORK_TREE="$YADM_HOOK_WORK"
gitleaks git --staged --no-banner --redact -v --log-level warn "$YADM_HOOK_WORK" || {
  echo "yadm: commit blocked, gitleaks found a possible secret (shown redacted above)" >&2
  exit 1
}
